{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrate",
  "subagent_depth": 2,
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 16384
  },
  "compaction": {
    "auto": true,
    "tail_turns": 8,
    "prune": true,
    "reserved": 772000
  },
  "provider": {
    "anthropic": {
      "options": {
        "setCacheKey": true
      },
      "models": {
        "claude-opus-5-5": {
          "limit": {
            "context": 1000000,
            "input": 922000,
            "output": 128000
          }
        }
      }
    }
  },
  "experimental": {
    "continue_loop_on_deny": true
  },
  "permission": {
    "read": "allow",
    "external_directory": {
      "*": "ask",
      "~/**": "allow",
      "/var/folders/**/T/opencode/**": "allow",
      "/private/var/folders/**/T/opencode/**": "allow",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow"
    },
    "bash": {
      "posthog-cli *": "ask",
      "/opt/homebrew/bin/posthog-cli *": "ask",
      "posthog-cli --help": "allow",
      "/opt/homebrew/bin/posthog-cli --help": "allow",
      "posthog-cli --version": "allow",
      "/opt/homebrew/bin/posthog-cli --version": "allow",
      "posthog-cli help *": "allow",
      "/opt/homebrew/bin/posthog-cli help *": "allow",
      "posthog-cli api --help": "allow",
      "/opt/homebrew/bin/posthog-cli api --help": "allow",
      "posthog-cli api --agent-help": "allow",
      "/opt/homebrew/bin/posthog-cli api --agent-help": "allow",
      "posthog-cli api tools": "allow",
      "/opt/homebrew/bin/posthog-cli api tools": "allow",
      "posthog-cli api search *": "allow",
      "/opt/homebrew/bin/posthog-cli api search *": "allow",
      "posthog-cli api info *": "allow",
      "/opt/homebrew/bin/posthog-cli api info *": "allow",
      "posthog-cli api schema *": "allow",
      "/opt/homebrew/bin/posthog-cli api schema *": "allow",
      "posthog-cli api skill list*": "allow",
      "/opt/homebrew/bin/posthog-cli api skill list*": "allow",
      "posthog-cli exp endpoints list*": "allow",
      "/opt/homebrew/bin/posthog-cli exp endpoints list*": "allow",
      "posthog-cli exp endpoints get *": "allow",
      "/opt/homebrew/bin/posthog-cli exp endpoints get *": "allow",
      "posthog-cli exp endpoints diff *": "allow",
      "/opt/homebrew/bin/posthog-cli exp endpoints diff *": "allow",
      "posthog-cli exp task list*": "allow",
      "/opt/homebrew/bin/posthog-cli exp task list*": "allow",
      "posthog-cli exp task progress*": "allow",
      "/opt/homebrew/bin/posthog-cli exp task progress*": "allow",
      "posthog-cli exp schema status*": "allow",
      "/opt/homebrew/bin/posthog-cli exp schema status*": "allow",
      "posthog-cli exp query check *": "allow",
      "/opt/homebrew/bin/posthog-cli exp query check *": "allow",
      "git rebase*": "allow",
      "gh *": "allow",
      "pup *": "ask",
      "/opt/homebrew/bin/pup *": "ask",
      "pup --no-agent auth status*": "allow",
      "/opt/homebrew/bin/pup --no-agent auth status*": "allow",
      "pup --no-agent --read-only *": "allow",
      "/opt/homebrew/bin/pup --no-agent --read-only *": "allow",
      "*npm run typecheck*": "deny",
      "*npm typecheck*": "deny",
      "*npm run lint*": "deny",
      "*npm lint*": "deny",
      "*npm run format*": "deny",
      "*npm format*": "deny",
      "*pnpm run typecheck*": "deny",
      "*pnpm typecheck*": "deny",
      "*pnpm run lint*": "deny",
      "*pnpm lint*": "deny",
      "*pnpm run format*": "deny",
      "*pnpm format*": "deny",
      "*yarn run typecheck*": "deny",
      "*yarn typecheck*": "deny",
      "*yarn run lint*": "deny",
      "*yarn lint*": "deny",
      "*yarn run format*": "deny",
      "*yarn format*": "deny",
      "*bun run typecheck*": "deny",
      "*bun typecheck*": "deny",
      "*bun run lint*": "deny",
      "*bun lint*": "deny",
      "*bun run format*": "deny",
      "*bun format*": "deny",
      "tsc": "deny",
      "./node_modules/.bin/tsc": "deny",
      "npx tsc": "deny",
      "bunx tsc": "deny",
      "pnpm exec tsc": "deny",
      "yarn exec tsc": "deny",
      "npm exec tsc": "deny",
      "*tsc --noEmit*": "deny",
      "*tsc -b*": "deny",
      "*tsc --build*": "deny",
      "*tsc -p*": "deny",
      "*turbo typecheck*": "deny",
      "*turbo lint*": "deny",
      "*turbo format*": "deny",
      "*eslint .": "deny",
      "*eslint . *": "deny",
      "*prettier .": "deny",
      "*prettier . *": "deny",
      "*biome .": "deny",
      "*biome . *": "deny",
      "*oxfmt .": "deny",
      "*oxfmt . *": "deny",
      "*oxlint .": "deny",
      "*oxlint . *": "deny"
    }
  },
  "tools": {
    "linear_*": true
  },
  "agent": {
    "plan": {
      "model": "anthropic/claude-opus-5-5",
      "color": "#2563EB",
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "build": {
      "model": "openai/gpt-6-luna",
      "color": "#0F766E"
    },
    "general": {
      "model": "openai/gpt-6-luna",
      "color": "#A16207"
    },
    "explore": {
      "model": "openai/gpt-6-luna",
      "color": "#4338CA"
    },
    "compaction": {
      "model": "openai/gpt-6-luna",
      "color": "#64748B"
    },
    "orchestrate": {
      "options": {
        "cacheControl": {
          "type": "ephemeral",
          "ttl": "1h"
        }
      }
    }
  },
  "small_model": "openai/gpt-5.4-nano",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec \"$HOME/.config/opencode/bin/playwright-mcp-worktree\" \"$@\"",
        "opencode-playwright"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "browsermcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@browsermcp/mcp@0.1.3"
      ],
      "enabled": false
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": false
    },
    "figwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@figwright/mcp@0.4.0"
      ],
      "enabled": false,
      "timeout": 120000
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp?toolsets=core%2Cprofiling",
      "enabled": false
    },
    "posthog": {
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp?readonly=true",
      "enabled": false
    }
  },
  "plugin": ["@ramtinj95/opencode-tokenscope", "@datadog/opencode-plugin", "./plugins/mcp-toggle.js"]
}
