    { "action": "shell", "resource": "posthog-cli exp task progress*", "effect": "allow" },
    { "action": "shell", "resource": "/opt/homebrew/bin/posthog-cli exp task progress*", "effect": "allow" },
    { "action": "shell", "resource": "posthog-cli exp schema status*", "effect": "allow" },
    { "action": "shell", "resource": "/opt/homebrew/bin/posthog-cli exp schema status*", "effect": "allow" },
    { "action": "shell", "resource": "posthog-cli exp query check *", "effect": "allow" },
    { "action": "shell", "resource": "/opt/homebrew/bin/posthog-cli exp query check *", "effect": "allow" },
    { "action": "shell", "resource": "git rebase*", "effect": "allow" },
    { "action": "shell", "resource": "gh *", "effect": "allow" },
    { "action": "shell", "resource": "pup *", "effect": "ask" },
    { "action": "shell", "resource": "/opt/homebrew/bin/pup *", "effect": "ask" },
    { "action": "shell", "resource": "pup --no-agent auth status*", "effect": "allow" },
