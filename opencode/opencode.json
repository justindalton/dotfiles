    { "action": "shell", "resource": "*npm run lint*", "effect": "deny" },
    { "action": "shell", "resource": "*npm lint*", "effect": "deny" },
    { "action": "shell", "resource": "*npm run format*", "effect": "deny" },
    { "action": "shell", "resource": "*npm format*", "effect": "deny" },
    { "action": "shell", "resource": "*pnpm run typecheck*", "effect": "deny" },
    { "action": "shell", "resource": "*pnpm typecheck*", "effect": "deny" },
    { "action": "shell", "resource": "*pnpm run lint*", "effect": "deny" },
    { "action": "shell", "resource": "*pnpm lint*", "effect": "deny" },
    { "action": "shell", "resource": "*pnpm run format*", "effect": "deny" },
    { "action": "shell", "resource": "*pnpm format*", "effect": "deny" },
    { "action": "shell", "resource": "*yarn run typecheck*", "effect": "deny" },
    { "action": "shell", "resource": "*yarn typecheck*", "effect": "deny" },
    { "action": "shell", "resource": "*yarn run lint*", "effect": "deny" },
    { "action": "shell", "resource": "*yarn lint*", "effect": "deny" },
    { "action": "shell", "resource": "*yarn run format*", "effect": "deny" },
    { "action": "shell", "resource": "*yarn format*", "effect": "deny" },
    { "action": "shell", "resource": "*bun run typecheck*", "effect": "deny" },
    { "action": "shell", "resource": "*bun typecheck*", "effect": "deny" },
    { "action": "shell", "resource": "*bun run lint*", "effect": "deny" },
    { "action": "shell", "resource": "*bun lint*", "effect": "deny" },
    { "action": "shell", "resource": "*bun run format*", "effect": "deny" },
    { "action": "shell", "resource": "*bun format*", "effect": "deny" },
    { "action": "shell", "resource": "tsc", "effect": "deny" },
    { "action": "shell", "resource": "./node_modules/.bin/tsc", "effect": "deny" },
    { "action": "shell", "resource": "npx tsc", "effect": "deny" },
    { "action": "shell", "resource": "bunx tsc", "effect": "deny" },
    { "action": "shell", "resource": "pnpm exec tsc", "effect": "deny" },
    { "action": "shell", "resource": "yarn exec tsc", "effect": "deny" },
    { "action": "shell", "resource": "npm exec tsc", "effect": "deny" },
    { "action": "shell", "resource": "*tsc --noEmit*", "effect": "deny" },
    { "action": "shell", "resource": "*tsc -b*", "effect": "deny" },
    { "action": "shell", "resource": "*tsc --build*", "effect": "deny" },
    { "action": "shell", "resource": "*tsc -p*", "effect": "deny" },
    { "action": "shell", "resource": "*turbo typecheck*", "effect": "deny" },
    { "action": "shell", "resource": "*turbo lint*", "effect": "deny" },
    { "action": "shell", "resource": "*turbo format*", "effect": "deny" },
    { "action": "shell", "resource": "*eslint .", "effect": "deny" },
    { "action": "shell", "resource": "*eslint . *", "effect": "deny" },
    { "action": "shell", "resource": "*prettier .", "effect": "deny" },
    { "action": "shell", "resource": "*prettier . *", "effect": "deny" },
    { "action": "shell", "resource": "*biome .", "effect": "deny" },
    { "action": "shell", "resource": "*biome . *", "effect": "deny" },
    { "action": "shell", "resource": "*oxfmt .", "effect": "deny" },
    { "action": "shell", "resource": "*oxfmt . *", "effect": "deny" },
    { "action": "shell", "resource": "*oxlint .", "effect": "deny" },
    { "action": "shell", "resource": "*oxlint . *", "effect": "deny" },
    { "action": "linear_*", "resource": "*", "effect": "allow" }
  ],
  "agents": {
    "title": {
      "model": "openai/gpt-6-luna#low",
      "system": "You generate a short title for a coding-agent session. It is shown as a terminal/pane title so the user can tell at a glance what each session is working on.\n\nOutput ONLY the title: one line, no quotes, no trailing punctuation, no explanation.\n\nFormat: \"<Feature>: <activity>\"\n- Feature = the concrete thing being worked on: a component, system, file area, PR, bug, or product feature (e.g. \"Herdr titles\", \"Billing webhooks\", \"PR 1234\", \"Auth refresh\"). Never the tool, agent, workflow, or slash command being used.\n- Activity = a short verb phrase for how it is being worked on: plan, fix, debug, investigate, review, refactor, add, remove, tune, migrate, test, document, etc., plus a key object if it adds clarity.\n- Sentence case. Aim for 45 characters or fewer; hard max 50.\n\nThe input is often a slash-command or skill expansion full of workflow boilerplate (agent instructions, routing tables, system reminders, plan-mode text, policy rules). Ignore that boilerplate and find the user's actual request or arguments inside it. If a branch name, issue ID, PR number, or file path names the feature, prefer it.\n\nIf no specific feature can be identified, write a plain short description of the task instead (still under 50 characters). Never output generic titles like \"New session\", \"Help request\", or \"Coding task\".\n\nExamples:\nHerdr titles: tune title prompt\nAuth refresh: debug token expiry\nPR 1234: address review feedback\nCheckout page: add Apple Pay\nBilling webhooks: fix retry backoff\nSearch API: plan pagination redesign"
    },
    "plan": {
      "model": "anthropic/claude-opus-5-5#low",
      "color": "#2563EB"
    },
    "build": {
      "model": "anthropic/claude-sonnet-5-5",
      "color": "#0F766E"
    },
    "general": {
      "model": "openai/gpt-6-luna",
      "color": "#A16207"
    },
    "explore": {
      "model": "openai/gpt-6-luna",
      "color": "#4338CA"
    },
    "compaction": {
      "model": "openai/gpt-6-luna",
      "color": "#64748B"
    },
    "orchestrate": {
      "model": "anthropic/claude-opus-5-5#medium"
    },
    "architect": {
      "model": "openai/gpt-6-astra#concise"
    },
    "implement": {
      "model": "openai/gpt-6-luna#concise"
    },
    "implement-complex": {
      "model": "anthropic/claude-opus-5-5#medium"
    },
    "debug": {
      "model": "anthropic/claude-opus-5-5"
    },
    "operate": {
      "model": "openai/gpt-6-luna#concise-low"
    },
    "review": {
      "model": "openai/gpt-6-astra#concise-high"
    },
    "verify": {
      "model": "openai/gpt-6-luna"
    }
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "exec \"$HOME/.config/opencode/bin/playwright-mcp-worktree\" \"$@\"",
          "opencode-playwright"
        ],
        "disabled": false,
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      },
      "browsermcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@browsermcp/mcp@0.1.3"
        ],
        "disabled": true
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "disabled": false
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp",
        "disabled": true
      },
      "figwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@figwright/mcp@0.4.0"
        ],
        "disabled": true,
        "timeout": {
          "catalog": 120000,
          "execution": 120000
        }
      },
      "datadog": {
        "type": "remote",
        "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp?toolsets=core%2Cprofiling",
        "disabled": true
      },
      "posthog": {
        "type": "remote",
        "url": "https://mcp.posthog.com/mcp?readonly=true",
        "disabled": true
      }
    }
  }
}
