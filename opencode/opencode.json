    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/var/folders/**/T/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/var/folders/**/T/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/**", "effect": "allow" },
    { "action": "shell", "resource": "posthog-cli *", "effect": "ask" },
    { "action": "shell", "resource": "/opt/homebrew/bin/posthog-cli *", "effect": "ask" },
    { "action": "shell", "resource": "posthog-cli --help", "effect": "allow" },
    { "action": "shell", "resource": "/opt/homebrew/bin/posthog-cli --help", "effect": "allow" },
    { "action": "shell", "resource": "posthog-cli --version", "effect": "allow" },
    { "action": "shell", "resource": "/opt/homebrew/bin/posthog-cli --version", "effect": "allow" },
    { "action": "shell", "resource": "posthog-cli help *", "effect": "allow" },
    { "action": "shell", "resource": "/opt/homebrew/bin/posthog-cli help *", "effect": "allow" },
    { "action": "shell", "resource": "posthog-cli api --help", "effect": "allow" },
    { "action": "shell", "resource": "/opt/homebrew/bin/posthog-cli api --help", "effect": "allow" },
    { "action": "shell", "resource": "posthog-cli api --agent-help", "effect": "allow" },
    { "action": "shell", "resource": "/opt/homebrew/bin/posthog-cli api --agent-help", "effect": "allow" },
    { "action": "shell", "resource": "posthog-cli api tools", "effect": "allow" },
    { "action": "shell", "resource": "/opt/homebrew/bin/posthog-cli api tools", "effect": "allow" },
    { "action": "shell", "resource": "posthog-cli api search *", "effect": "allow" },
    { "action": "shell", "resource": "/opt/homebrew/bin/posthog-cli api search *", "effect": "allow" },
    { "action": "shell", "resource": "posthog-cli api info *", "effect": "allow" },
    { "action": "shell", "resource": "/opt/homebrew/bin/posthog-cli api info *", "effect": "allow" },
    { "action": "shell", "resource": "posthog-cli api schema *", "effect": "allow" },
    { "action": "shell", "resource": "/opt/homebrew/bin/posthog-cli api schema *", "effect": "allow" },
    { "action": "shell", "resource": "posthog-cli api skill list*", "effect": "allow" },
    { "action": "shell", "resource": "/opt/homebrew/bin/posthog-cli api skill list*", "effect": "allow" },
    { "action": "shell", "resource": "posthog-cli exp endpoints list*", "effect": "allow" },
    { "action": "shell", "resource": "/opt/homebrew/bin/posthog-cli exp endpoints list*", "effect": "allow" },
    { "action": "shell", "resource": "posthog-cli exp endpoints get *", "effect": "allow" },
    { "action": "shell", "resource": "/opt/homebrew/bin/posthog-cli exp endpoints get *", "effect": "allow" },
    { "action": "shell", "resource": "posthog-cli exp endpoints diff *", "effect": "allow" },
