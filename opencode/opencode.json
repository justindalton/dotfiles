{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrate",
  "subagent_depth": 1,
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 16384
  },
  "compaction": {
    "auto": true,
    "tail_turns": 8
  },
  "experimental": {
    "continue_loop_on_deny": true
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/.agents/**": "allow",
      "/var/folders/**/T/opencode/**": "allow",
      "/private/var/folders/**/T/opencode/**": "allow",
      "/tmp/opencode/**": "allow",
      "/private/tmp/opencode/**": "allow",
      "~/.npm/_npx/**": "allow",
      "~/.config/opencode/**": "allow"
    }
  },
  "agent": {
    "plan": {
      "model": "anthropic/claude-opus-5",
      "reasoningEffort": "default",
      "textVerbosity": "low"
    },
    "build": {
      "model": "openai/gpt-5.6-luna"
    },
    "general": {
      "model": "openai/gpt-5.6-luna"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec \"$HOME/.config/opencode/bin/playwright-mcp-worktree\" \"$@\"",
        "opencode-playwright"
      ],
      "enabled": false,
      "timeout": 30000
    },
    "browsermcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@browsermcp/mcp@0.1.3"
      ],
      "enabled": false
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": false
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": false
    },
    "figwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@figwright/mcp@0.4.0"
      ],
      "enabled": false,
      "timeout": 120000
    }
  },
  "plugin": ["@ramtinj95/opencode-tokenscope"]
}
