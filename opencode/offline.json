{
  "$schema": "https://opencode.ai/config.json",
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "lmstudio",
      "effect": "allow"
    }
  ],
  "providers": {
    "lmstudio": {
      "name": "LM Studio (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen3.8-27b-mlx@4bit": {
          "name": "Qwen 3.8 27B MLX 4-bit",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 116736,
            "output": 8192
          },
          "variants": [
            {
              "id": "local",
              "body": {
                "temperature": 1.0,
                "top_p": 0.95
              }
            }
          ]
        }
      }
    }
  },
  "model": "lmstudio/qwen3.8-27b-mlx@4bit",
  "default_agent": "local-orchestrate",
  "update": "disable",
  "share": "disabled",
  "compaction": {
    "auto": true,
    "buffer": 16000
  },
  "agents": {
    "compaction": {
      "model": "lmstudio/qwen3.8-27b-mlx@4bit#local"
    },
    "title": {
      "model": "lmstudio/qwen3.8-27b-mlx@4bit#local"
    },
    "summary": {
      "model": "lmstudio/qwen3.8-27b-mlx@4bit#local"
    },
    "explore": {
      "model": "lmstudio/qwen3.8-27b-mlx@4bit#local"
    },
    "general": {
      "model": "lmstudio/qwen3.8-27b-mlx@4bit#local"
    },
    "build": {
      "model": "lmstudio/qwen3.8-27b-mlx@4bit#local"
    },
    "plan": {
      "model": "lmstudio/qwen3.8-27b-mlx@4bit#local"
    },
    "orchestrate": {
      "disabled": true
    },
    "implement": {
      "disabled": true
    },
    "implement-complex": {
      "disabled": true
    },
    "review": {
      "disabled": true
    },
    "verify": {
      "disabled": true
    },
    "operate": {
      "disabled": true
    },
    "debug": {
      "disabled": true
    },
    "architect": {
      "disabled": true
    },
    "local-orchestrate": {
      "mode": "primary",
      "description": "Coordinates local offline work and delegates scoped tasks to local agents.",
      "color": "#0F766E",
      "system": "{file:./offline/local-orchestrate.md}",
      "model": "lmstudio/qwen3.8-27b-mlx@4bit#local",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "local-explore",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "local-implement",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "local-review",
          "effect": "allow"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "local-explore": {
      "mode": "subagent",
      "description": "Performs concise, read-only repository discovery.",
      "color": "#4338CA",
      "system": "{file:./offline/local-explore.md}",
      "model": "lmstudio/qwen3.8-27b-mlx@4bit#local",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git diff*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git status*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git rev-parse*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "ls*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rg *",
          "effect": "allow"
        }
      ]
    },
    "local-implement": {
      "mode": "subagent",
      "description": "Implements only explicitly scoped offline tasks.",
      "color": "#15803D",
      "system": "{file:./offline/local-implement.md}",
      "model": "lmstudio/qwen3.8-27b-mlx@4bit#local",
      "steps": 30,
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git push*",
          "effect": "deny"
        }
      ]
    },
    "local-review": {
      "mode": "subagent",
      "description": "Reviews diffs for actionable defects without editing files.",
      "color": "#BE185D",
      "system": "{file:./offline/local-review.md}",
      "model": "lmstudio/qwen3.8-27b-mlx@4bit#local",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git diff*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git status*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git rev-parse*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git merge-base*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git branch --show-current",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git worktree list*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "bunx turbo test --filter=*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "vitest run *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "vitest --run *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "bunx vitest run *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "bunx vitest --run *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npx vitest run *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "pnpm exec vitest run *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "yarn exec vitest run *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "bun test *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm test -- *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "pnpm test -- *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "yarn test *",
          "effect": "allow"
        }
      ]
    }
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "exec \"$HOME/.config/opencode/bin/playwright-mcp-worktree\" \"$@\"",
          "opencode-playwright"
        ],
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        },
        "disabled": true
      },
      "browsermcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@browsermcp/mcp@0.1.3"
        ],
        "disabled": true
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "disabled": true
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp",
        "disabled": true
      },
      "figwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@figwright/mcp@0.4.0"
        ],
        "timeout": {
          "catalog": 120000,
          "execution": 120000
        },
        "disabled": true
      },
      "datadog": {
        "type": "remote",
        "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp?toolsets=core%2Cprofiling",
        "disabled": true
      },
      "posthog": {
        "type": "remote",
        "url": "https://mcp.posthog.com/mcp?readonly=true",
        "disabled": true
      }
    }
  },
  "permissions": [
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
